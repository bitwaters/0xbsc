# 将本文件复制为项目目录下的 .env，再填写空白字段。
# SEA 路径：/www/wwwroot/0xbsc/.env
# 不填写私钥或助记词。不要把填写后的 .env 提交到 GitHub。
# 值包含 # 或空格时用单引号包裹；本程序不会执行或展开变量。

# live = 正式推送；dry_run = 运行筛选但不发送正式推送。
RUNTIME_MODE=live

# 新研究事实记录：observe 只复用已有响应，不增加 API 请求或改变正式筛选。
# Docker Compose 默认 observe；应用直接启动且未配置时默认 off。
RESEARCH_MODE=observe
RESEARCH_RUN_ID=research-observe-v1

# GMGN Plus OpenAPI 的 API Key。
GMGN_API_KEY=

# 用于查询报价的 BSC 公开钱包地址，0x 开头；不是私钥。
GMGN_QUOTE_WALLET=

# Telegram BotFather 提供的 Bot Token。
TELEGRAM_BOT_TOKEN=

# 推送目标的数字 Chat ID；多个用英文逗号分隔。群组 ID 通常为负数。
TELEGRAM_CHAT_IDS=

# 可选：管理员 Telegram 数字用户 ID，多个用英文逗号分隔。
# 留空表示不授权任何管理操作；不影响推送，所有人都可点击 GMGN 链接。
# 当前用于兼容旧版管理回调；快捷指令尚未实现，后续也只允许管理员使用。
TELEGRAM_ALLOWED_USER_IDS=
